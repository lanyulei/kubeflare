KUBEFLARE_SERVICE__ENVIRONMENT=local

KUBEFLARE_AUTH__SIGNING_KEY=local-development-signing-key-change-me
KUBEFLARE_PROXY__ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

KUBEFLARE_DATABASE__ENABLED=false
KUBEFLARE_DATABASE__DSN=postgres://postgres:password@127.0.0.1:5432/kubeflare?sslmode=disable

KUBEFLARE_REDIS__ENABLED=false
KUBEFLARE_REDIS__ADDRESS=127.0.0.1:6379
KUBEFLARE_REDIS__PASSWORD=

KUBEFLARE_AI__ENABLED=false
KUBEFLARE_AI__DEFAULT_PROVIDER=deepseek
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__TYPE=openai_compatible
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__BASE_URL=https://api.deepseek.com
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__CHAT_PATH=/chat/completions
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__API_KEY=
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__MODEL=deepseek-chat
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__TIMEOUT=30s
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__STREAM=true
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__TEMPERATURE=0.7
KUBEFLARE_AI__PROVIDERS__DEEPSEEK__MAX_TOKENS=4096
